# 本地环境
VITE_USER_NODE_ENV = 'development'

# 公共基础路径
VITE_PUBLIC_PATH = /

# 路由模式
# Optional: hash | history
VITE_ROUTER_MODE = history

# 打包时是否删除 console
VITE_DROP_CONSOLE = true

# 是否开启 VitePWA
VITE_PWA = false

# 打包时是否生成  交互式可视化报告页面
VITE_ANALYZE = false

# 开发环境接口地址
VITE_API_URL = /kjj-api

# 开发环境跨域代理，支持配置多个
VITE_PROXY = [["/api","https://mock.mengxuegu.com/mock/629d727e6163854a32e8307e"],["/mock-api","https://mock.mengxuegu.com/mock/68f1ee4f70c0466d224c0dfe"],["/kjj-api","http://192.168.1.142:8012"],["/research-monitor","http://192.168.1.142:8012/"]]
